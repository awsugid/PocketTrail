{
	"name": "pockettrail",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
		"preview": "npm run build && wrangler dev",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test:unit": "vitest run",
		"test:e2e": "node e2e/run.mjs",
		"test:ui": "node e2e/ui.mjs",
		"test:journeys": "node e2e/journeys/runner.mjs inventory txns imports settings races responsibility invitations",
		"test": "npm run test:unit && npm run test:e2e && npm run test:journeys",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:seed:local": "wrangler d1 execute DB --local --file tests/fixtures/seed.sql",
		"test:extraction": "node static/extraction.test.cjs"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.77.0",
		"@sveltejs/adapter-cloudflare": "9.0.0",
		"@sveltejs/kit": "3.4.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^22.20.5",
		"cn": "^0.5.2",
		"playwright": "^1.61.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "6.0.3",
		"vite": "8.3.8",
		"vitest": "5.1.0",
		"wrangler": "4.162.0"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.4",
		"bits-ui": "^2.21.0"
	},
	"overrides": {
		"runed": "0.38.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
