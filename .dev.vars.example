# Copy to .dev.vars (git-ignored). Local development only.
LOCAL_DEV=true

# HMAC key for session cookies: at least 32 characters.
SECRET_SESSION_KEY=

# Public Google OAuth client ID. Leave empty to keep Google sign-in reported as
# unconfigured; fixture sign-in still works on loopback hosts.
GOOGLE_CLIENT_ID=

# Keep local delivery disabled; tests never contact a real mail server.
# Production can enable invitation delivery with the existing SMTP settings.
EMAIL_DELIVERY_ENABLED=false
APP_ORIGIN=http://localhost:8787
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
