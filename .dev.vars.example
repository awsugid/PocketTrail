# Copy to .dev.vars (git-ignored). Local development only.
LOCAL_DEV=true

# HMAC key for session cookies: at least 32 characters.
SECRET_SESSION_KEY=

# Public Google OAuth client ID. Leave empty to keep Google sign-in reported as
# unconfigured; fixture sign-in still works on loopback hosts.
GOOGLE_CLIENT_ID=

# Invitation email transport is deliberately disabled. Delivery attempts record
# a local outbox/mail row and never contact a real mail server.
EMAIL_DELIVERY_ENABLED=false
